@ARTICLE{darijani_gmtorch_gm_ieee_short,
  title     = "gmtorch: Computing with Gaussian Mixture Uncertainty in PyTorch",
  author    = "Ali Darijani and Benedikt Stratmann and Genís Floriach Pigem and Jürgen Beyerer and Luisa Hoffmann and Michael Heizmann",
  abstract  = "Gaussian mixture models (GMMs) can represent multimodal, non-Gaussian
uncertainty while retaining analytical structure. Scientific workflows,
however, require more than fitting a mixture to observations: uncertain
quantities must remain available for subsequent transformations, arithmetic,
conditioning, and information combination. We present gmtorch, a
PyTorch framework for computing with GMM-represented uncertain scalar
and vector quantities. Mixtures may be constructed from parameters or
estimated from data; every mixture-valued result remains a complete distribution that can be
evaluated, sampled, summarized, conditioned, or used in a subsequent
calculation. Marginalization, conditioning, affine maps, sums and differences under
independence, and normalized density products are evaluated analytically and
can be composed with assumptions made explicit by the selected operations and
with component counts tracked. When nonlinear maps leave the finite-GMM family, or exact operations
produce impractically many components, the framework provides explicit
sample--transform--refit propagation and mixture reduction. Full-covariance
computations use Cholesky-based linear algebra and blocked pairwise kernels.
Reference checks compare exact operations with independently assembled
formulas, and a single-epoch localization example illustrates sequential
likelihood-based updating. The
contribution is a consistent software realization of
established GMM calculus, with exact and approximate steps made explicit.
",
  journal   = "2026 IEEE Sensor Data Fusion: Trends, Solutions, Applications (SDF)",
  publisher = "IEEE",
  year      =  2026,
  language  = "en",
  keywords  = "Gaussian Mixture, Probability",
  selected  = "false",
  status    = "accepted",
  pdf       = "https://publikationen.bibliothek.kit.edu/1000198401/194823910",
  doi       = {https://doi.org/10.5445/IR/1000198401 },
  url       = {https://doi.org/10.5445/IR/1000198401 },
  gitlab    = "https://gitlab.kit.edu/ali.darijani/gmtorch.git",
  draft     = "false",
}




@ARTICLE{darijani_gm_factor_graphs,
  title     = "Gaussian Mixture Belief Propagation for Hybrid Inference in Factor Graphs",
  author    = "Luisa Hoffmann and Ali Darijani and Jürgen Beyerer and Michael Heizmann",
  abstract  = "Sensor data fusion in industrial systems often requires combining continuous measurements with discrete semantic information while accounting for measurement uncertainty and multimodal distributions. We propose Gaussian Mixture Belief Propagation (GMBP), a probabilistic message-passing frame-work for hybrid factor graphs that represents discrete-continuous dependencies using Gaussian mixture models (GMMs). For each discrete state, the corresponding continuous evidence is represented by a conditional GMM, enabling multimodal distributions to be propagated between continuous and discrete variables. In particular, GMBP supports both hard and uncertain continuous evidence and provides closed-form message updates in both directions. The resulting framework enables the fusion of multiple continuous evidence sources into a common discrete hypothesis while retaining the uncertainty of the individual measurements. A synthetic two-class example demonstrates the bidirectional fusion of hard and soft evidence. On a real-world fault classification benchmark, 25 repeated stratified cross-validation runs show that adaptively selecting the Gaussian mixture order per class and feature via Bayesian Information Criterion (BIC) improves accuracy by 5–10 percentage points over both a single-Gaussian baseline and a fixed-order mixture. This demonstrates the benefit of GMBP’s data-driven multimodal representation and highlights the potential of GMM-based belief propagation for probabilistic hybrid sensor data fusion with multimodal continuous evidence.",
  journal   = "2026 IEEE Sensor Data Fusion: Trends, Solutions, Applications (SDF)",
  publisher = "IEEE",
  year      =  2026,
  language  = "en",
  keywords  = "postprint,conference,IEEE,Gaussian Mixture, Probability",
  status    = "accepted",
  selected  = "false",
  draft     = "false",
}
