@ARTICLE{darijani_geometric_gm_curve_ieee_short,
  title     = "A Geometric Gaussian Mixture Representation of Curves and Trajectories in Euclidean Space",
  author    = "Benedikt Stratmann and Emadedin Soufian and Jürgen Beyerer and Ali Darijani",
  abstract  = "Curves and trajectories in Euclidean spaces are fundamental objects in tracking and 
  sensor data fusion. Gaussian mixture models (GMMs) are widely used as flexible parametric 
  probability density functions (PDFs) over the object state space. They are typically obtained 
  by applying expectation-maximization (EM)-based schemes to point samples. However, when the 
  underlying geometric structure is known deterministically, for example, a road centerline 
  in map-assisted tracking, a nominal flight path, or a planned robot trajectory, such 
  iterative fitting is unnecessary, potentially slow, and only indirectly reflects the 
  underlying curve or trajectory. We propose a purely arithmetic, geometry-driven 
  construction that directly maps a curve or trajectory in a Euclidean space, 
  together with user-defined transverse uncertainty, to a GMM in a single pass, 
  without EM or iterative optimization. Starting from a parametrized curve, we 
  construct a uniform discretized polygonal representation and assign each segment 
  a standard deviation in its normal subspace. This results in thin, curve-aligned 
  Gaussian primitives that encode position, tangent, normal, and length scale, together 
  with transverse uncertainty. By choosing component weights proportional to segment 
  lengths, the resulting probability distribution is uniform with respect to arc length. 
  Consequently, all GMM parameters are obtained directly from the discretized geometry 
  and the prescribed uncertainty profile. The construction accommodates smooth, 
  open, closed, non-regular, and self-intersecting curves and trajectories in 
  arbitrary-dimensional Euclidean spaces. It supports adaptive discretization 
  and spatially varying uncertainty, yielding differentiable GMMs that directly 
  encode the underlying geometric structure. We demonstrate the approach using 
  canonical planar curves and nominal trajectories, and conduct a simulation study 
  in higher-dimensional Euclidean spaces to compare approximation quality and 
  computational runtime against EM-based fitting. Potential applications include 
  map- and road-constrained tracking and sensor data fusion, uncertainty-aware 
  trajectory planning, probabilistic obstacle and boundary modeling in robotics, 
  and uncertainty-aware computer-aided design (CAD) and digital twins.",
  journal   = "2026 IEEE International Conference on Multisensor Fusion and Integration for Intelligent Systems (MFI)",
  publisher = "IEEE",
  year      =  2026,
  language  = "en",
  selected  = "true",
  pdf       = "/doc/geometric_gmm_plane_curve_theory_ieee_paper.pdf",
  draft     = "false",
}

@ARTICLE{darijani_gmtorch_gm_ieee_short,
  title     = "gmtorch: Computing with Gaussian Mixture Uncertainty in PyTorch",
  author    = "Ali Darijani and Benedikt Stratmann and Genís Floriach Pigem and Jürgen Beyerer and Luisa Hoffmann and Michael Heizmann",
  abstract  = "Gaussian mixture models (GMMs) can represent multimodal, non-Gaussian
uncertainty while retaining analytical structure. Scientific workflows,
however, require more than fitting a mixture to observations: uncertain
quantities must remain available for subsequent transformations, arithmetic,
conditioning, and information combination. We present gmtorch, a
PyTorch framework for computing with GMM-represented uncertain scalar
and vector quantities. Mixtures may be constructed from parameters or
estimated from data; every mixture-valued result remains a complete distribution that can be
evaluated, sampled, summarized, conditioned, or used in a subsequent
calculation. Marginalization, conditioning, affine maps, sums and differences under
independence, and normalized density products are evaluated analytically and
can be composed with assumptions made explicit by the selected operations and
with component counts tracked. When nonlinear maps leave the finite-GMM family, or exact operations
produce impractically many components, the framework provides explicit
sample--transform--refit propagation and mixture reduction. Full-covariance
computations use Cholesky-based linear algebra and blocked pairwise kernels.
Reference checks compare exact operations with independently assembled
formulas, and a single-epoch localization example illustrates sequential
likelihood-based updating. The
contribution is a consistent software realization of
established GMM calculus, with exact and approximate steps made explicit.
",
  journal   = "2026 IEEE Sensor Data Fusion: Trends, Solutions, Applications (SDF)",
  publisher = "IEEE",
  year      =  2026,
  language  = "en",
  selected  = "false",
  pdf       = "/doc/SDF2026_gmtorch.pdf",
  draft     = "false",
}

@ARTICLE{darijani_ccpt_gm_probabilistic_qc,
  title     = "Stakeholder-Based Deterministic and Probabilistic Quality Control Using Gaussian Mixtures for Circular Factories",
  author    = "Ali Darijani and Gabriel Moser and Kristian Vlajic and Zahra Sadat Hajseyed Nasrollah and Luisa Hoffmann and Mehdi Khabou and Tobias Düser and Albert Albers, Stefan Dietrich, Michael Heizmann, Jürgen Beyerer",
  abstract  = "Quality Control (QC) in Circular Factorys (CFs) is fundamentally more challenging due to the uncertainty of the incoming products to be reprocessed, compared to linear factories, which have tight tolerances on the input raw materials and parts. One must have an expressive model to manage the multimodality of circular factories. QC and the decision making process that it entails can be understood as a mapping from system requirements and variation space to discrete decisions, which can be formulated either deterministically or probabilistically. Ideally, the model must also be able to handle the deterministic and probabilistic cases seamlessly. Gaussian Mixture Models (GMMs) and their universal approximation property are considered suitable for the circular factory context. GMM can also address deterministic cases by approximating the Dirac delta as a limiting case. We present a stakeholder-oriented QC framework in which stakeholder requirements, product generations, and alternative solutions for new product generations are represented probabilistically over quality-relevant variation spaces. Two complementary decision perspectives are considered. First, stakeholder requirements, exemplified by customer requirements, are modeled as acceptance regions, and the probability that a product generation satisfies individual, joint, or alternative requirements is computed by integrating the corresponding GMM density over these regions. Second, stakeholder requirements and alternative solutions are represented as probability density functions, and distance- and divergence-based metrics are used to quantify their dissimilarity. These metrics support threshold-based acceptance and ranking of alternative solutions under uncertainty. Special attention is given to deterministic limits, threshold design, and the interpretation of distances and divergences when comparing GMMs. The proposed framework provides a basis for stakeholder-based deterministic and probabilistic QC and decision support in circular factories.",
  journal   = "2026 Conference on Circular Production Systems and Technologies (CCPT)",
  publisher = "Springer",
  year      =  2026,
  language  = "en",
  selected  = "false",
  pdf       = "/doc/ccpt_probabilistic_quality_control.pdf",
  draft     = "false",
}

