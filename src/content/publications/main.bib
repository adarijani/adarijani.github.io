@ARTICLE{darijani_ccpt_ded_reprocessed,
  title     = "Probabilistic Process-Structure-Property Modelling for Hardness and Porosity Estimation in High-Speed DED-Reprocessed Components in the context of the Circular Factory",
  author    = "Luisa Hoffmann and Mehdi Khabou and Helena Wexel and Ali Darijani and Jürgen Beyerer and Frederik Zanger and Volker Schulze and Stefan Dietrich and Michael
Heizmann",
 abstract   = "In Circular Factory (CF) environments, used components are
disassembled, characterized, and reprocessed, based on a reliable 
estimation of the resulting material properties and taking measurement and
remanufacturing uncertainties into consideration. For reprocessing steps
such as High-Speed Laser Directed Energy Deposition (HS DED-LB), 
uncertainties and process variability critically affect the robustness and sta-
bility of process-structure-property predictions. Additionally, 
measurements introduce uncertainties that propagate into the estimation of the
post-process material state. For remanufactured structural components, hardness and porosity serve as key quality indicators describing the ma-
terial state. Both are investigated as key determinants of fatigue 
performance, since hardness governs local fatigue strength, while porosity acts
as a stress concentrator that promotes early fatigue crack initiation and
reduces fatigue strength and component lifetime. In HS DED-LB, laser
power and scan speed govern the thermal input and thereby influence 
microstructure development and resulting material properties. The process
parameters can act as physically based features representing the thermal
history and its fluctuations to correlate the process to the material state.
To address this issue, Gaussian Mixture Models (GMMs) are adopted as
a unified probabilistic framework to represent multimodal uncertainty
and enable consistent inference under process variability and 
measurement noise. This paper presents a probabilistic approach for modelling
and fusing measurement and process uncertainties using GMMs, 
resulting in probability density functions of hardness and porosity after HS
DED-LB reprocessing. The approach enables uncertainty-aware 
estimation of the material state and supports adaptive tuning of reprocessing
parameters to achieve the desired target quality characteristics in circular
factories.",
  journal   = "2026 Conference on Circular Production Systems and Technologies (CCPT)",
  publisher = "Springer",
  year      =  2026,
  language  = "en",
  selected  = "false",
  pdf       = "/doc/ccpt_ded_reprocessed.pdf",
  draft     = "false",
}



@ARTICLE{darijani_ccpt_vison_circular_factory,
  title     = "Bringing the Vision of Perpetual Innovative Products to Life - challenges and opportunities at the circular factory for angle grinders",
  author    = "Patric Grauberger and Jonas Hemmerich and Nehal Afifi and Victor Mas and Dominik Koch and Edwin Blum and Kristian Vlajic and Mehdi Khabou and Helena Wexel and Gabriel Moser and Gisela Lanza and Albert Albers and Tobias Düser and Luisa Hoffmann and Michael Heizmann and Ali Darijani and Jürgen Beyerer and Frederik Zanger and Stefan Dietrich and Sven Matthiesen",
 abstract   = "In the circular economy, the contradiction between developing innovative 
 products and reusing products from the market is a huge challenge. On the one hand,
products returned from the market are, by design, unable to meet the 
requirements and functions of the newest product generation, hindering innovation in
circularity. On the other hand, retaining the product’s added value is a 
powerful lever for enabling sustainable circularity. Perpetual innovative products could
solve this contradiction. However, the problem is that up to now it remains mostly a vision. This vision needs to address three key challenges to come to life:
analyzing used products and subsystems, predicting functionality at the 
individual level, and reprocessing subsystems in a way that enables them to fulfill
the newest functions. In this paper, we illustrate the collaborative approach to
address these challenges. We structure insights and the challenges encountered
in various solutions for implementing this vision, using the example of a 
circular factory for angle grinders. From incorporating asymmetrical degradation into
product specifications to measuring strategies and reprocessing parameters, this
paper shows how a vision can come to life. The uncovered insights and 
difficulties reveal opportunities for further development and interdisciplinary research
in circular factories.",
  journal   = "2026 Conference on Circular Production Systems and Technologies (CCPT)",
  publisher = "Springer",
  year      =  2026,
  language  = "en",
  selected  = "false",
  pdf       = "/doc/ccpt_bringing_the_vision.pdf",
  draft     = "false",
}



@ARTICLE{darijani_gm_reduction_mfi,
  title         = "Neural Network-Based Gaussian Mixture Reduction",
  author        = "Luisa Hoffmann and Linus Fischer and Alper Saritas and Ali Darijani and Jürgen Beyerer and Michael Heizmann",
  abstract      = "Gaussian mixtures (GMs) are a well-established
tool for the compact representation and processing of complex
probability distributions and are used, among other things, in
sensor data fusion. When fusing multiple GMs, the number
of components grows exponentially, increasing computational
and memory requirements. Reduction methods are therefore
necessary to replace a large GM with a compact approximation
having significantly fewer components. This paper provides
an overview of existing reduction methods as a benchmark.
Furthermore, a novel approach using neural network (NN) for
GM reduction is derived. This includes the training structure
of the NN, the per-sample fine-tuning and a hybrid approach
that combines the pretrained NN with a KMeans algorithm.
To overcome the issue of a collapsed NN initialization the
paper presents a dead-cluster recovery rule, which improves the
Integrated Squared Error (ISE). Both the benchmark methods
and the novel NN methods are compared in terms of their
runtime and accuracy for various dimensions and cardinalities.
The runtime of the NN with KMeans matches the runtime of
the cheapest classical method but surpasses these methods in 
terms of accuracy.",
  year          =  2026,
  keywords      = "Gaussian Mixture, Probability",
  venue         = "Accepted to 2026 IEEE International Conference on Multisensor Fusion and Integration for Intelligent Systems (MFI)",
  draft         = "false",
}
