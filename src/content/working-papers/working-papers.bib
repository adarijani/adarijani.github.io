@article{darijani_dirichlet_gaussian,
  title     = "Dirichlet Gaussian Distributions on Embedded Simplices",
  author    = "Ali Darijani",
  abstract  = "We derive a geometry-independent Gaussian approximation for distributions
near embedded simplices, combining arbitrary-parameter Dirichlet distributions with in-
dependent Gaussian noise in orthogonal normal spaces. The optimal ambient Gaussian
matches the mean and covariance, yielding an explicit minimum forward KL divergence
depending only on intrinsic dimension and Dirichlet parameters. For finite mixtures with
shared weights, we prove a global upper bound given by the weighted sum of component-
wise divergences. In the uniform case, this bound depends only on intrinsic dimension,
independently of ambient dimension, simplex geometry, and normal covariances.",
